[
  {
    "name": "theme_info",
    "theme_name": "Desa Coding",
    "theme_version": "1.0.0",
    "theme_author": "Desa Coding",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 260,
        "step": 5,
        "unit": "px",
        "label": "t:labels.logo_width",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon",
        "info": "t:info.favicon"
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "header",
        "content": "t:general.brand_colors"
      },
      {
        "type": "color",
        "id": "color_primary",
        "default": "#0F172A",
        "label": "t:labels.color_primary"
      },
      {
        "type": "color",
        "id": "color_accent",
        "default": "#2563EB",
        "label": "t:labels.color_accent"
      },
      {
        "type": "color",
        "id": "color_accent_secondary",
        "default": "#06B6D4",
        "label": "t:labels.color_accent_secondary"
      },
      {
        "type": "header",
        "content": "t:general.surface_colors"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#F8FAFC",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "color_surface",
        "default": "#FFFFFF",
        "label": "t:labels.color_surface"
      },
      {
        "type": "color",
        "id": "color_border",
        "default": "#E2E8F0",
        "label": "t:labels.color_border"
      },
      {
        "type": "header",
        "content": "t:general.text_colors"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#0F172A",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "color_text_secondary",
        "default": "#64748B",
        "label": "t:labels.color_text_secondary"
      },
      {
        "type": "header",
        "content": "t:general.status_colors"
      },
      {
        "type": "color",
        "id": "color_success",
        "default": "#16A34A",
        "label": "t:labels.color_success"
      },
      {
        "type": "color",
        "id": "color_error",
        "default": "#DC2626",
        "label": "t:labels.color_error"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:labels.font_body",
        "info": "t:info.font_body"
      },
      {
        "type": "range",
        "id": "type_heading_weight",
        "min": 500,
        "max": 800,
        "step": 100,
        "label": "t:labels.font_heading_weight",
        "default": 700
      },
      {
        "type": "range",
        "id": "type_base_size",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "label": "t:labels.font_base_size",
        "default": 16
      }
    ]
  },
  {
    "name": "t:general.buttons_and_shape",
    "settings": [
      {
        "type": "select",
        "id": "button_style",
        "label": "t:labels.button_style",
        "options": [
          { "value": "solid", "label": "t:options.button_style.solid" },
          { "value": "outline", "label": "t:options.button_style.outline" }
        ],
        "default": "solid"
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "t:labels.corner_radius",
        "default": 10,
        "info": "t:info.corner_radius"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 8
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          { "value": "75rem", "label": "t:options.page_width.narrow" },
          { "value": "90rem", "label": "t:options.page_width.standard" },
          { "value": "110rem", "label": "t:options.page_width.wide" }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 24
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:labels.section_spacing",
        "default": 64
      }
    ]
  },
  {
    "name": "t:general.product_cards",
    "settings": [
      {
        "type": "select",
        "id": "product_card_style",
        "label": "t:labels.product_card_style",
        "options": [
          { "value": "card--bordered", "label": "t:options.product_card_style.bordered" },
          { "value": "card--minimal", "label": "t:options.product_card_style.minimal" }
        ],
        "default": "card--bordered"
      },
      {
        "type": "select",
        "id": "product_card_image_ratio",
        "label": "t:labels.product_card_image_ratio",
        "options": [
          { "value": "1 / 1", "label": "t:options.image_ratio.square" },
          { "value": "4 / 5", "label": "t:options.image_ratio.portrait" },
          { "value": "16 / 9", "label": "t:options.image_ratio.landscape" }
        ],
        "default": "1 / 1"
      },
      {
        "type": "checkbox",
        "id": "product_card_quick_add",
        "label": "t:labels.product_card_quick_add",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.header_and_cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "sticky_header",
        "label": "t:labels.sticky_header",
        "default": true
      },
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:labels.cart_type",
        "options": [
          { "value": "drawer", "label": "t:options.cart_type.drawer" },
          { "value": "page", "label": "t:options.cart_type.page" }
        ],
        "default": "drawer"
      }
    ]
  },
  {
    "name": "t:general.animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "t:labels.enable_animations",
        "info": "t:info.enable_animations",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.social_media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "info": "t:info.social_url"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook",
        "info": "t:info.social_url"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok",
        "info": "t:info.social_url"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube",
        "info": "t:info.social_url"
      },
      {
        "type": "text",
        "id": "social_x",
        "label": "X (Twitter)",
        "info": "t:info.social_url"
      },
      {
        "type": "text",
        "id": "social_linkedin",
        "label": "LinkedIn",
        "info": "t:info.social_url"
      }
    ]
  },
  {
    "name": "t:general.contact_information",
    "settings": [
      {
        "type": "text",
        "id": "contact_email",
        "label": "t:labels.contact_email"
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "t:labels.contact_phone"
      },
      {
        "type": "text",
        "id": "contact_address",
        "label": "t:labels.contact_address"
      }
    ]
  }
]

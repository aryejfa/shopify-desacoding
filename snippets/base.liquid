{% doc %}
  Renders the theme's shared design-system stylesheet: typography scale,
  buttons, cards, badges, form fields, accordions and layout utilities used
  across every section, block and snippet. Rendered once from the layout so
  the generated CSS is deduplicated and cached across every page.

  @example
  {% render 'base' %}
{% enddoc %}

{% stylesheet %}
  /* Typography scale */
  body {
    font-size: var(--font-base-size);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1, h2, h3, h4, h5, h6,
  .h1, .h2, .h3, .h4, .h5, .h6 {
    font-family: var(--font-primary--family);
    font-weight: var(--font-heading--weight);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
  }

  h1, .h1 { font-size: clamp(2rem, 1.6rem + 2vw, 3.25rem); }
  h2, .h2 { font-size: clamp(1.5rem, 1.3rem + 1vw, 2.25rem); }
  h3, .h3 { font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.625rem); }
  h4, .h4 { font-size: 1.25rem; }
  h5, .h5 { font-size: 1.0625rem; }
  h6, .h6 { font-size: 1rem; }

  a {
    color: var(--color-accent);
    text-underline-offset: 0.15em;
  }

  small, .text-sm { font-size: 0.875rem; }

  .text-secondary { color: var(--color-text-secondary); }
  .text-center { text-align: center; }

  .eyebrow {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-block-end: 0.5rem;
  }

  /* Focus states */
  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--style-border-radius-sm);
  }

  /* Motion & reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* Accessibility utilities */
  .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-link {
    position: fixed;
    z-index: 1000;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: var(--color-surface);
    color: var(--color-foreground);
    border-radius: var(--style-border-radius-sm);
    box-shadow: var(--shadow-md);
    transform: translateY(-150%);
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  /* Section spacing */
  .section-padding {
    padding-block: var(--section-spacing);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-block-end: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .section-header--center {
    align-items: center;
    text-align: center;
  }

  .section-header__heading {
    margin: 0;
  }

  .section-header__description {
    max-width: 60ch;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .section-header--center .section-header__description {
    margin-inline: auto;
  }

  .section-header__actions {
    margin-block-start: 0.5rem;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    appearance: none;
    cursor: pointer;
    border: 1px solid transparent;
    border-radius: var(--style-border-radius-full);
    font: inherit;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1;
    padding: 0.9rem 1.6rem;
    text-decoration: none;
    background: var(--color-accent);
    color: #fff;
    transition: background-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .btn:hover {
    background: color-mix(in srgb, var(--color-accent) 85%, black);
  }

  .btn:active {
    transform: scale(0.98);
  }

  .btn[disabled], .btn.is-disabled {
    cursor: not-allowed;
    opacity: 0.5;
    transform: none;
  }

  .btn--secondary {
    background: var(--color-surface);
    color: var(--color-foreground);
    border-color: var(--color-border);
  }

  .btn--secondary:hover {
    background: var(--color-background);
  }

  .btn--outline {
    background: transparent;
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .btn--outline:hover {
    background: var(--color-accent);
    color: #fff;
  }

  .btn--sm {
    padding: 0.6rem 1.1rem;
    font-size: 0.8125rem;
  }

  .btn--lg {
    padding: 1.1rem 2rem;
    font-size: 1rem;
  }

  .btn--block {
    width: 100%;
  }

  .btn--icon {
    padding: 0.6rem;
    border-radius: var(--style-border-radius-full);
  }

  /* Global button-style preference: outline-first stores */
  body[data-button-style='outline'] .btn:not(.btn--secondary):not(.btn--outline) {
    background: transparent;
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  body[data-button-style='outline'] .btn:not(.btn--secondary):not(.btn--outline):hover {
    background: var(--color-accent);
    color: #fff;
  }

  /* Cards */
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .card--minimal {
    border-color: transparent;
    box-shadow: none;
  }

  .card--padded {
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  /* Badges */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border-radius: var(--style-border-radius-full);
    background: var(--color-background);
    color: var(--color-foreground);
    border: 1px solid var(--color-border);
  }

  .badge--sale {
    background: color-mix(in srgb, var(--color-accent-secondary) 16%, white);
    color: color-mix(in srgb, var(--color-accent-secondary) 55%, var(--color-primary));
    border-color: transparent;
  }

  .badge--sold-out {
    background: var(--color-background);
    color: var(--color-text-secondary);
  }

  .badge--success {
    background: color-mix(in srgb, var(--color-success) 14%, white);
    color: var(--color-success);
    border-color: transparent;
  }

  /* Price */
  .price {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--color-foreground);
  }

  .price--on-sale .price__regular {
    color: var(--color-error);
  }

  .price__compare {
    font-weight: 500;
    font-size: 0.875em;
    color: var(--color-text-secondary);
    text-decoration: line-through;
  }

  .price--unavailable {
    color: var(--color-text-secondary);
  }

  /* Icons */
  .icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .icon--sm { width: 1rem; height: 1rem; }
  .icon--lg { width: 1.75rem; height: 1.75rem; }

  /* Form fields */
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: left;
  }

  .field__label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .field__input {
    font: inherit;
    padding: 0.8rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-surface);
    color: var(--color-foreground);
  }

  .field__input:focus-visible {
    border-color: var(--color-accent);
  }

  .field--error .field__input {
    border-color: var(--color-error);
  }

  .field__message {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .field--error .field__message {
    color: var(--color-error);
  }

  .field__message--success {
    color: var(--color-success) !important;
  }

  /* Quantity selector */
  .quantity-selector {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
    background: var(--color-surface);
  }

  .quantity-selector__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-foreground);
  }

  .quantity-selector__button:hover {
    background: var(--color-background);
  }

  .quantity-selector__input {
    width: 3rem;
    border: none;
    border-inline: 1px solid var(--color-border);
    text-align: center;
    font: inherit;
    background: transparent;
    color: var(--color-foreground);
  }

  /* Accordion */
  .accordion {
    border-block-end: 1px solid var(--color-border);
  }

  .accordion:first-of-type {
    border-block-start: 1px solid var(--color-border);
  }

  .accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
  }

  .accordion__summary::-webkit-details-marker {
    display: none;
  }

  .accordion__icon {
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  .accordion[open] .accordion__icon {
    transform: rotate(180deg);
  }

  .accordion__content {
    padding-block-end: 1.25rem;
    color: var(--color-text-secondary);
  }

  /* Empty / error states */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    padding-block: clamp(2rem, 1.5rem + 2vw, 4rem);
    color: var(--color-text-secondary);
  }

  /* Star rating */
  .rating {
    display: inline-flex;
    gap: 0.15rem;
    color: var(--color-accent-secondary);
  }

  /* Simple fade-in used sparingly, disabled entirely when animations are off */
  [data-animate] {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity var(--motion-duration-slow) var(--motion-ease),
      transform var(--motion-duration-slow) var(--motion-ease);
  }

  [data-animate].is-visible {
    opacity: 1;
    transform: none;
  }
{% endstylesheet %}

{% javascript %}
  const animationsDisabled =
    document.body.dataset.animations === 'disabled' ||
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (animationsDisabled || !('IntersectionObserver' in window)) {
    document.querySelectorAll('[data-animate]').forEach((el) => el.classList.add('is-visible'));
  } else {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px' }
    );

    document.querySelectorAll('[data-animate]').forEach((el) => revealObserver.observe(el));
  }
{% endjavascript %}

{% doc %}
  Renders the theme's design tokens as CSS custom properties on `:root`,
  sourced from the merchant's Theme Settings. Rendered once in the `<head>`
  so every section/block/snippet stylesheet can consume the same tokens.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    /* Typography */
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --font-heading--weight: {{ settings.type_heading_weight | default: 700 }};
    --font-base-size: {{ settings.type_base_size | default: 16 }}px;

    /* Layout */
    --page-width: {{ settings.max_page_width | default: '90rem' }};
    --page-margin: {{ settings.min_page_margin | default: 24 }}px;
    --section-spacing: {{ settings.section_spacing | default: 64 }}px;

    /* Colors */
    --color-background: {{ settings.background_color | default: '#F8FAFC' }};
    --color-foreground: {{ settings.foreground_color | default: '#0F172A' }};
    --color-surface: {{ settings.color_surface | default: '#FFFFFF' }};
    --color-border: {{ settings.color_border | default: '#E2E8F0' }};
    --color-text-secondary: {{ settings.color_text_secondary | default: '#64748B' }};
    --color-primary: {{ settings.color_primary | default: '#0F172A' }};
    --color-accent: {{ settings.color_accent | default: '#2563EB' }};
    --color-accent-secondary: {{ settings.color_accent_secondary | default: '#06B6D4' }};
    --color-success: {{ settings.color_success | default: '#16A34A' }};
    --color-error: {{ settings.color_error | default: '#DC2626' }};

    --color-primary-rgb: {{ settings.color_primary | color_to_rgb | remove: 'rgb(' | remove: ')' }};
    --color-accent-rgb: {{ settings.color_accent | color_to_rgb | remove: 'rgb(' | remove: ')' }};
    --color-foreground-rgb: {{ settings.foreground_color | color_to_rgb | remove: 'rgb(' | remove: ')' }};

    /* Shape */
    --style-border-radius-inputs: {{ settings.input_corner_radius | default: 8 }}px;
    --style-border-radius: {{ settings.corner_radius | default: 10 }}px;
    --style-border-radius-lg: calc(var(--style-border-radius) * 1.6);
    --style-border-radius-sm: calc(var(--style-border-radius) * 0.5);
    --style-border-radius-full: 999px;

    /* Elevation */
    --shadow-sm: 0 1px 2px rgba(var(--color-foreground-rgb), 0.06);
    --shadow-md: 0 4px 12px rgba(var(--color-foreground-rgb), 0.08);
    --shadow-lg: 0 12px 32px rgba(var(--color-foreground-rgb), 0.12);

    /* Motion */
    {% if settings.enable_animations %}
      --motion-duration: 200ms;
      --motion-duration-slow: 400ms;
    {% else %}
      --motion-duration: 0ms;
      --motion-duration-slow: 0ms;
    {% endif %}
    --motion-ease: cubic-bezier(0.16, 1, 0.3, 1);

    /* Icons */
    --icon-stroke-width: 1.5px;
  }
{% endstyle %}

{% comment %}
  A flexible promo/campaign banner: image on the left or right, paired with
  a heading, description and call to action. Useful for promos, new
  classes, or a featured product/service.
{% endcomment %}

<div class="promo-banner full-width section-padding {{ section.settings.image_position }}">
  <div class="promo-banner__inner">
    {% if section.settings.image != blank %}
      <div class="promo-banner__media">
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            widths: '400, 600, 900, 1200, 1400',
            sizes: '(min-width: 750px) 50vw, 100vw',
            loading: 'lazy',
            alt: section.settings.image.alt | default: section.settings.heading,
            class: 'promo-banner__image'
        }}
      </div>
    {% endif %}

    <div class="promo-banner__content" data-animate>
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="promo-banner__heading h2">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="promo-banner__description text-secondary">{{ section.settings.description }}</p>
      {% endif %}
      {% render 'button', label: section.settings.cta_label, url: section.settings.cta_link %}
    </div>
  </div>
</div>

{% stylesheet %}
  .promo-banner__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: center;
  }

  .promo-banner--image-right .promo-banner__media {
    order: 2;
  }

  .promo-banner__media {
    border-radius: var(--style-border-radius-lg);
    overflow: hidden;
  }

  .promo-banner__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .promo-banner__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .promo-banner__heading,
  .promo-banner__description {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .promo-banner__inner {
      grid-template-columns: 1fr;
    }

    .promo-banner--image-right .promo-banner__media {
      order: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.promotional_banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "options": [
        { "value": "promo-banner--image-left", "label": "t:options.image_position.left" },
        { "value": "promo-banner--image-right", "label": "t:options.image_position.right" }
      ],
      "default": "promo-banner--image-left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.subheading",
      "default": "Kelas baru"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Tingkatkan kemampuan coding Anda"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Ikuti kelas dan produk digital terbaru dari Desa Coding, dirancang untuk pemula hingga tingkat lanjut."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label",
      "default": "Jelajahi sekarang"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.cta_link"
    }
  ],
  "presets": [{ "name": "t:general.promotional_banner" }]
}
{% endschema %}

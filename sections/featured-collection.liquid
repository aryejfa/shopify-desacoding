{% comment %}
  Showcases products from a merchant-selected collection using the shared
  product card. Never hardcodes a collection or product.
{% endcomment %}

<div class="featured-collection full-width section-padding">
  <div class="featured-collection__inner">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="section-header">
        {% if section.settings.heading != blank %}
          <h2 class="section-header__heading h3">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <p class="section-header__description">{{ section.settings.description }}</p>
        {% endif %}
        {% if section.settings.collection != blank and section.settings.view_all_label != blank %}
          <div class="section-header__actions">
            {% render 'button', label: section.settings.view_all_label, url: section.settings.collection.url, style: 'outline' %}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.collection != blank %}
      <div
        class="product-grid"
        style="
          --grid-cols-mobile: {{ section.settings.columns_mobile }};
          --grid-cols-desktop: {{ section.settings.columns_desktop }};
        "
      >
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <p class="text-secondary">{{ 'general.editor.select_collection' | t }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .featured-collection__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols-mobile, 2), 1fr);
    gap: 1.25rem 1rem;
  }

  @media screen and (min-width: 750px) {
    .product-grid {
      grid-template-columns: repeat(var(--grid-cols-desktop, 4), 1fr);
      gap: 2rem 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Produk pilihan"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:labels.view_all_label",
      "default": "Lihat semua"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    }
  ],
  "presets": [{ "name": "t:general.featured_collection" }]
}
{% endschema %}

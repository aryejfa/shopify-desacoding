{% comment %}
  Renders the slide-out cart drawer used when `settings.cart_type` is
  `drawer`. Rendered once from `layout/theme.liquid` so it's available on
  every page. Also hosts the theme's shared cart AJAX controller, which
  progressively enhances the native cart form (quantity update, remove,
  add to cart) on every page; everything still works as plain form
  submissions when JavaScript fails to load.
{% endcomment %}

{% liquid
  assign t_close = 'general.accessibility.close' | t
%}

<dialog
  id="cart-drawer"
  class="cart-drawer"
  scroll-lock
  aria-labelledby="cart-drawer-title"
  data-cart-drawer
  data-section-id="cart-drawer"
>
  {% form 'cart', cart, class: 'cart-drawer__form' %}
    <div class="cart-drawer__header">
      <h2 id="cart-drawer-title" class="h5">{{ 'cart.title' | t }} ({{ cart.item_count }})</h2>
      <button type="button" class="btn btn--icon btn--secondary" data-cart-drawer-close>
        {% render 'icon', name: 'close', title: t_close %}
      </button>
    </div>

    <div class="cart-drawer__body" data-cart-drawer-body>
      {% render 'cart-items' %}
    </div>

    {% if cart.item_count > 0 %}
      <div class="cart-drawer__footer">
        <div class="cart-drawer__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="text-secondary text-sm">{{ 'cart.taxes_and_shipping_at_checkout' | t }}</p>

        <div class="cart-drawer__actions">
          <noscript>
            <button type="submit" name="update" class="btn btn--secondary btn--block">{{ 'cart.update' | t }}</button>
          </noscript>
          <button type="submit" name="checkout" class="btn btn--block" data-cart-checkout>
            {{ 'cart.checkout' | t }}
          </button>
        </div>
      </div>
    {% endif %}
  {% endform %}
</dialog>

{% stylesheet %}
  .cart-drawer {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    margin: 0;
    height: 100dvh;
    max-height: 100dvh;
    width: min(28rem, 100vw);
    max-width: 100vw;
    border: none;
    padding: 0;
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }

  .cart-drawer::backdrop {
    background: rgba(0, 0, 0, 0.4);
  }

  .cart-drawer[open] {
    display: flex;
  }

  .cart-drawer__form {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
    border-block-end: 1px solid var(--color-border);
  }

  .cart-drawer__header h2 {
    margin: 0;
  }

  .cart-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
  }

  .cart-drawer__footer {
    border-block-start: 1px solid var(--color-border);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    font-weight: 700;
    font-size: 1.125rem;
  }

  .cart-drawer__actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-block-start: 0.5rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cart-drawer {
      transition: translate var(--motion-duration) var(--motion-ease), display var(--motion-duration) allow-discrete,
        overlay var(--motion-duration) allow-discrete;
      translate: 100% 0;
    }

    .cart-drawer[open] {
      translate: 0 0;
    }

    @starting-style {
      .cart-drawer[open] {
        translate: 100% 0;
      }
    }
  }
{% endstylesheet %}

{% javascript %}
  class CartController {
    constructor() {
      this.drawer = document.querySelector('[data-cart-drawer]');
      this.routes = window.themeRoutes || {};
      document.addEventListener('click', this.handleClick.bind(this));
      document.addEventListener('submit', this.handleSubmit.bind(this));
      document.addEventListener('change', this.handleChange.bind(this));
      document.addEventListener('keydown', this.handleKeydown.bind(this));
    }

    openDrawer() {
      if (this.drawer && typeof this.drawer.showModal === 'function') {
        this.drawer.showModal();
      }
    }

    closeDrawer() {
      if (this.drawer && this.drawer.open) {
        this.drawer.close();
      }
    }

    handleKeydown(event) {
      if (event.key === 'Escape' && this.drawer && this.drawer.open) {
        this.closeDrawer();
      }
    }

    handleClick(event) {
      if (event.target.closest('[data-cart-drawer-open]') || event.target.closest('[data-cart-drawer-trigger]')) {
        event.preventDefault();
        this.openDrawer();
      }

      if (event.target.closest('[data-cart-drawer-close]')) {
        event.preventDefault();
        this.closeDrawer();
      }

      const decrease = event.target.closest('[data-quantity-decrease]');
      const increase = event.target.closest('[data-quantity-increase]');
      if (decrease || increase) {
        const wrapper = (decrease || increase).closest('[data-quantity-selector]');
        const input = wrapper.querySelector('[data-quantity-input]');
        const current = parseInt(input.value, 10) || 0;
        const next = decrease ? Math.max(0, current - 1) : current + 1;
        input.value = next;
        this.updateLine(input.dataset.lineKey, next, input);
      }

      const remove = event.target.closest('[data-cart-remove]');
      if (remove) {
        event.preventDefault();
        this.updateLine(remove.dataset.lineKey, 0, remove);
      }
    }

    handleChange(event) {
      const input = event.target.closest('[data-quantity-input]');
      if (input) {
        const quantity = Math.max(0, parseInt(input.value, 10) || 0);
        this.updateLine(input.dataset.lineKey, quantity, input);
      }
    }

    handleSubmit(event) {
      const form = event.target.closest('[data-product-form]');
      if (!form) return;

      event.preventDefault();
      this.addToCart(form);
    }

    getSectionIds() {
      const ids = ['cart-drawer'];
      const pageSection = document.querySelector('[data-cart-page]');
      if (pageSection && pageSection.dataset.sectionId) {
        ids.push(pageSection.dataset.sectionId);
      }
      return ids;
    }

    async addToCart(form) {
      const submitter = form.querySelector('[type="submit"]');
      const errorEl = form.querySelector('[data-form-error]');
      if (submitter) submitter.setAttribute('aria-busy', 'true');
      if (errorEl) errorEl.hidden = true;

      try {
        const formData = new FormData(form);
        formData.append('sections', this.getSectionIds().join(','));

        const response = await fetch(this.routes.cartAddUrl, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData,
        });
        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.description || data.message);
        }

        this.renderSections(data.sections);
        this.openDrawer();
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
      } catch (error) {
        if (errorEl) {
          errorEl.textContent = error.message || window.themeStrings.cartErrorGeneric;
          errorEl.hidden = false;
        }
      } finally {
        if (submitter) submitter.removeAttribute('aria-busy');
      }
    }

    async updateLine(key, quantity, originEl) {
      const line = originEl.closest('[data-cart-item]');
      if (line) line.classList.add('is-loading');

      try {
        const response = await fetch(this.routes.cartChangeUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ id: key, quantity, sections: this.getSectionIds().join(',') }),
        });
        const data = await response.json();

        if (data.status) {
          const message = (data.errors || data.description || window.themeStrings.cartErrorGeneric).toString();
          const errorEl = line ? line.querySelector('[data-line-error]') : null;
          if (errorEl) {
            errorEl.textContent = message;
            errorEl.hidden = false;
          }
          return;
        }

        this.renderSections(data.sections);
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
      } catch (error) {
        // Network error: leave the native form as the fallback (Update button still works).
      } finally {
        if (line) line.classList.remove('is-loading');
      }
    }

    renderSections(sections) {
      if (!sections) return;
      Object.keys(sections).forEach((id) => {
        const target = document.querySelector(`[data-section-id="${id}"]`);
        if (!target) return;
        const doc = new DOMParser().parseFromString(sections[id], 'text/html');
        const fresh = doc.querySelector(`[data-section-id="${id}"]`);
        if (!fresh) return;

        if (id === 'cart-drawer') {
          // Keep the live <dialog> node so its open/modal state is preserved;
          // only swap its contents (header count, items, footer).
          target.innerHTML = fresh.innerHTML;
        } else {
          target.replaceWith(fresh);
        }
      });
    }
  }

  if (!window.cartController) {
    window.cartController = new CartController();
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.cart_drawer",
  "settings": []
}
{% endschema %}

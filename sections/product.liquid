{% comment %}
  Product page: media gallery, title, price, variant picker, quantity,
  add-to-cart / dynamic checkout, description, extra info accordions
  (including optional metafields) and native product recommendations.
{% endcomment %}

<div class="product section-padding full-width">
  <div class="product__inner">
    <div class="product__media">
      {% render 'product-media', product: product %}
    </div>

    <div class="product__info">
      {% if product.vendor != blank %}
        <p class="text-secondary text-sm">{{ product.vendor }}</p>
      {% endif %}

      <h1 class="product__title h2">{{ product.title }}</h1>

      {% render 'product-form', product: product, show_dynamic_checkout: section.settings.show_dynamic_checkout %}

      <div class="product__accordions">
        {% if product.description != blank %}
          <details class="accordion" open>
            <summary class="accordion__summary">
              <span>{{ 'products.description' | t }}</span>
              {% render 'icon', name: 'chevron-down', class: 'accordion__icon' %}
            </summary>
            <div class="accordion__content rte">{{ product.description }}</div>
          </details>
        {% endif %}

        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'accordion' %}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary class="accordion__summary">
                  <span>{{ block.settings.heading }}</span>
                  {% render 'icon', name: 'chevron-down', class: 'accordion__icon' %}
                </summary>
                <div class="accordion__content rte">{{ block.settings.content }}</div>
              </details>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div data-product-recommendations data-product-id="{{ product.id }}" data-url="{{ routes.product_recommendations_url }}"></div>

{% stylesheet %}
  .product__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }

  .product__info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 6rem;
  }

  .product__title {
    margin: 0;
  }

  .product__accordions {
    margin-block-start: 1rem;
  }

  .rte > * + * {
    margin-block-start: 1em;
  }

  @media screen and (max-width: 989px) {
    .product__inner {
      grid-template-columns: 1fr;
    }

    .product__info {
      position: static;
    }
  }
{% endstylesheet %}

{% javascript %}
  const recommendationsEl = document.querySelector('[data-product-recommendations]');

  if (recommendationsEl) {
    const url = `${recommendationsEl.dataset.url}?section_id=product-recommendations&product_id=${recommendationsEl.dataset.productId}&limit=4`;

    fetch(url)
      .then((response) => response.text())
      .then((html) => {
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const content = doc.querySelector('[data-section-id="product-recommendations"]');
        if (content) recommendationsEl.replaceWith(content);
      })
      .catch(() => {});
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:labels.enable",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "t:general.accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Pengiriman & pengembalian"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:labels.description",
          "info": "t:info.connect_metafield"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}

{% comment %}
  A hand-picked list of products chosen by the merchant via the native
  product-list picker (never hardcoded IDs).
{% endcomment %}

<div class="featured-products full-width section-padding">
  <div class="featured-products__inner">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="section-header section-header--center">
        {% if section.settings.heading != blank %}
          <h2 class="section-header__heading h3">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <p class="section-header__description">{{ section.settings.description }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.products.size > 0 %}
      <div
        class="product-grid"
        style="--grid-cols-mobile: 2; --grid-cols-desktop: {{ section.settings.products.size | at_most: 4 }};"
      >
        {% for product in section.settings.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <p class="text-secondary">{{ 'general.editor.select_products' | t }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .featured-products__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Rekomendasi untuk Anda"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "t:labels.products",
      "limit": 8
    }
  ],
  "presets": [{ "name": "t:general.featured_products" }]
}
{% endschema %}

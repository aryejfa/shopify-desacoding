{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

<div class="blog section-padding full-width">
  <div class="blog__inner">
    <h1 class="h2">{{ blog.title }}</h1>

    {% paginate blog.articles by 9 %}
      <div class="blog__grid">
        {% for article in blog.articles %}
          <a href="{{ article.url }}" class="blog-card card">
            {% if article.image %}
              {{
                article.image
                | image_url: width: 800
                | image_tag: widths: '400, 600, 800', loading: 'lazy', alt: article.image.alt, class: 'blog-card__image'
              }}
            {% endif %}
            <div class="blog-card__content">
              <h2 class="blog-card__title h5">{{ article.title }}</h2>
              {% assign date = article.published_at | time_tag: format: 'date' %}
              <p class="text-secondary text-sm">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
              <p class="text-secondary">{{ article.excerpt | default: article.content | strip_html | truncatewords: 20 }}</p>
            </div>
          </a>
        {% endfor %}
      </div>

      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {% endpaginate %}
  </div>
</div>

{% stylesheet %}
  .blog__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .blog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.5rem;
    margin-block-start: 1.5rem;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }

  .blog-card__image {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    width: 100%;
  }

  .blog-card__content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .blog-card__title {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %}

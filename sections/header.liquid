{% comment %}
  Main site header: logo, desktop navigation with dropdowns, search,
  customer account, cart, and an accessible mobile drawer. Navigation comes
  entirely from the linklist chosen below (Shopify Navigation), never
  hardcoded.
{% endcomment %}

{% liquid
  assign t_menu = 'general.accessibility.menu' | t
  assign t_search = 'general.accessibility.search' | t
  assign t_cart = 'general.accessibility.cart' | t
  assign t_close = 'general.accessibility.close' | t
  assign t_main_nav = 'general.accessibility.main_navigation' | t
%}

<header class="site-header {% if settings.sticky_header %}site-header--sticky{% endif %}" data-header>
  <div class="site-header__inner">
    <button
      type="button"
      class="btn btn--icon btn--secondary site-header__menu-toggle"
      data-mobile-nav-open
      aria-haspopup="dialog"
    >
      {% render 'icon', name: 'menu', title: t_menu %}
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {% if settings.logo %}
        {{
          settings.logo
          | image_url: width: settings.logo_width
          | image_tag:
            widths: '80, 120, 160, 200, 260',
            alt: shop.name,
            loading: 'eager',
            fetchpriority: 'high',
            class: 'site-header__logo-image'
        }}
      {% else %}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>

    {% if section.settings.menu.links.size > 0 %}
      <nav class="site-header__nav" aria-label="{{ t_main_nav }}">
        <ul>
          {% for link in section.settings.menu.links %}
            <li class="site-header__nav-item">
              {% if link.links != blank %}
                <details class="site-header__dropdown">
                  <summary class="site-header__nav-link">
                    {{ link.title }}
                    {% render 'icon', name: 'chevron-down', class: 'icon--sm' %}
                  </summary>
                  <ul class="site-header__dropdown-menu">
                    {% for child_link in link.links %}
                      <li>
                        <a href="{{ child_link.url }}" {% if child_link.current %}aria-current="page"{% endif %}>
                          {{ child_link.title }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                </details>
              {% else %}
                <a
                  href="{{ link.url }}"
                  class="site-header__nav-link"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ link.title }}
                </a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    <div class="site-header__actions">
      <button type="button" class="btn btn--icon btn--secondary" data-search-open aria-haspopup="dialog">
        {% render 'icon', name: 'search', title: t_search %}
      </button>

      {% if shop.customer_accounts_enabled %}
        <shopify-account class="site-header__account" menu="{{ section.settings.customer_account_menu }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      {% if settings.cart_type == 'drawer' %}
        <button
          type="button"
          class="btn btn--icon btn--secondary site-header__cart"
          data-cart-drawer-open
          aria-haspopup="dialog"
        >
      {% else %}
        <a href="{{ routes.cart_url }}" class="btn btn--icon btn--secondary site-header__cart">
      {% endif %}
      {% render 'icon', name: 'cart', title: t_cart %}
      <span class="site-header__cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>
        {{- cart.item_count -}}
      </span>
      {% if settings.cart_type == 'drawer' %}
        </button>
      {% else %}
        </a>
      {% endif %}
    </div>
  </div>
</header>

<dialog id="mobile-nav" class="mobile-nav" scroll-lock data-mobile-nav aria-label="{{ t_main_nav }}">
  <div class="mobile-nav__header">
    <a href="{{ routes.root_url }}" class="site-header__logo">
      {% if settings.logo %}
        {{ settings.logo | image_url: width: 120 | image_tag: alt: shop.name, class: 'site-header__logo-image' }}
      {% else %}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>
    <button type="button" class="btn btn--icon btn--secondary" data-mobile-nav-close>
      {% render 'icon', name: 'close', title: t_close %}
    </button>
  </div>

  <nav class="mobile-nav__nav" aria-label="{{ t_main_nav }}">
    <ul>
      {% for link in section.settings.menu.links %}
        <li>
          {% if link.links != blank %}
            <details>
              <summary>
                {{ link.title }}
                {% render 'icon', name: 'chevron-down', class: 'icon--sm' %}
              </summary>
              <ul class="mobile-nav__submenu">
                {% for child_link in link.links %}
                  <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                {% endfor %}
              </ul>
            </details>
          {% else %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>

  {% if shop.customer_accounts_enabled %}
    <a href="{{ routes.account_url }}" class="mobile-nav__account-link">
      {% render 'icon', name: 'account' %}
      {{ 'general.accessibility.account' | t }}
    </a>
  {% endif %}
</dialog>

<dialog id="search-dialog" class="search-dialog" scroll-lock data-search-dialog aria-label="{{ 'search.title' | t }}">
  <div class="search-dialog__inner">
    <form
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      class="search-dialog__form"
      data-predictive-search
    >
      <input type="hidden" name="type" value="product,page,article">
      {% render 'icon', name: 'search' %}
      <input
        type="search"
        name="q"
        value="{{ search.terms }}"
        placeholder="{{ 'search.placeholder' | t }}"
        autocomplete="off"
        data-search-input
        aria-label="{{ 'search.placeholder' | t }}"
        aria-controls="search-results"
        aria-expanded="false"
      >
      <button type="button" class="btn btn--icon btn--secondary" data-search-close>
        {% render 'icon', name: 'close', title: t_close %}
      </button>
    </form>

    <div id="search-results" class="search-dialog__results" data-predictive-search-results hidden aria-live="polite"></div>
  </div>
</dialog>

{% stylesheet %}
  .site-header {
    background: var(--color-surface);
    border-block-end: 1px solid var(--color-border);
    z-index: 30;
  }

  .site-header--sticky {
    position: sticky;
    top: 0;
  }

  .site-header__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    height: 4.75rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-header__menu-toggle {
    display: none;
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    margin-inline-end: auto;
  }

  .site-header__logo-image {
    width: auto;
    max-height: 2.5rem;
  }

  .site-header__logo-text {
    font-family: var(--font-primary--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.25rem;
    color: var(--color-foreground);
  }

  .site-header__nav > ul {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
  }

  .site-header__nav-link,
  .site-header__dropdown summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.6rem 0.85rem;
    text-decoration: none;
    color: var(--color-foreground);
    font-weight: 500;
    font-size: 0.9375rem;
    border-radius: var(--style-border-radius-sm);
    cursor: pointer;
    list-style: none;
  }

  .site-header__nav-link::-webkit-details-marker,
  .site-header__dropdown summary::-webkit-details-marker {
    display: none;
  }

  .site-header__nav-link:hover,
  .site-header__dropdown summary:hover {
    background: var(--color-background);
  }

  .site-header__nav-link[aria-current='page'] {
    color: var(--color-accent);
  }

  .site-header__dropdown {
    position: relative;
  }

  .site-header__dropdown-menu {
    list-style: none;
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0;
    min-width: 12rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius);
    box-shadow: var(--shadow-md);
    padding: 0.5rem;
    display: none;
  }

  .site-header__dropdown[open] .site-header__dropdown-menu {
    display: block;
  }

  @media (hover: hover) {
    .site-header__dropdown:hover .site-header__dropdown-menu {
      display: block;
    }
  }

  .site-header__dropdown-menu a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: var(--style-border-radius-sm);
    text-decoration: none;
    color: var(--color-foreground);
    font-size: 0.9rem;
  }

  .site-header__dropdown-menu a:hover {
    background: var(--color-background);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .site-header__cart {
    position: relative;
  }

  .site-header__cart-count {
    position: absolute;
    top: -0.2rem;
    right: -0.2rem;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6875rem;
    font-weight: 700;
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--style-border-radius-full);
  }

  @media screen and (max-width: 899px) {
    .site-header__nav {
      display: none;
    }

    .site-header__menu-toggle {
      display: inline-flex;
    }

    .site-header__inner {
      height: 4rem;
    }
  }

  /* Mobile nav drawer */
  .mobile-nav {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    margin: 0;
    height: 100dvh;
    width: min(22rem, 85vw);
    max-width: 85vw;
    border: none;
    padding: 1.25rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
    overflow-y: auto;
  }

  .mobile-nav::backdrop {
    background: rgba(0, 0, 0, 0.4);
  }

  .mobile-nav__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: 1.5rem;
  }

  .mobile-nav__nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .mobile-nav__nav > ul > li {
    border-block-end: 1px solid var(--color-border);
  }

  .mobile-nav__nav a,
  .mobile-nav__nav summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 0.25rem;
    text-decoration: none;
    color: var(--color-foreground);
    font-weight: 500;
    cursor: pointer;
  }

  .mobile-nav__nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__submenu {
    padding-inline-start: 1rem;
    padding-block-end: 0.5rem;
  }

  .mobile-nav__submenu a {
    padding-block: 0.6rem;
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .mobile-nav__account-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-block-start: 1.5rem;
    text-decoration: none;
    color: var(--color-foreground);
    font-weight: 500;
  }

  /* Search dialog */
  .search-dialog {
    margin: 0 auto;
    margin-block-start: 10dvh;
    width: min(38rem, 92vw);
    border: none;
    border-radius: var(--style-border-radius);
    padding: 0;
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }

  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
  }

  .search-dialog__inner {
    padding: 0.75rem;
  }

  .search-dialog__form {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
  }

  .search-dialog__form input[type='search'] {
    flex: 1;
    border: none;
    outline: none;
    font: inherit;
    background: transparent;
    color: var(--color-foreground);
  }

  .search-dialog__form input[type='search']::-webkit-search-cancel-button {
    display: none;
  }

  .search-dialog__form button {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-secondary);
    display: inline-flex;
  }

  .search-dialog__results {
    max-height: 60vh;
    overflow-y: auto;
    margin-block-start: 0.5rem;
  }

  .predictive-search-results {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .predictive-search-results a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.5rem;
    border-radius: var(--style-border-radius-sm);
    text-decoration: none;
    color: var(--color-foreground);
  }

  .predictive-search-results a:hover {
    background: var(--color-background);
  }

  .predictive-search-results img {
    border-radius: var(--style-border-radius-sm);
    flex-shrink: 0;
  }

  .predictive-search-result__title {
    font-weight: 500;
  }
{% endstylesheet %}

{% javascript %}
  const header = document.querySelector('[data-header]');
  const mobileNav = document.querySelector('[data-mobile-nav]');
  const searchDialog = document.querySelector('[data-search-dialog]');

  document.querySelector('[data-mobile-nav-open]')?.addEventListener('click', () => mobileNav?.showModal());
  document.querySelector('[data-mobile-nav-close]')?.addEventListener('click', () => mobileNav?.close());
  mobileNav?.addEventListener('click', (event) => {
    if (event.target === mobileNav) mobileNav.close();
  });

  document.querySelector('[data-search-open]')?.addEventListener('click', () => {
    searchDialog?.showModal();
    searchDialog?.querySelector('[data-search-input]')?.focus();
  });
  document.querySelector('[data-search-close]')?.addEventListener('click', () => searchDialog?.close());
  searchDialog?.addEventListener('click', (event) => {
    if (event.target === searchDialog) searchDialog.close();
  });

  // Close open desktop dropdowns on outside click / Escape.
  document.addEventListener('click', (event) => {
    document.querySelectorAll('.site-header__dropdown[open]').forEach((el) => {
      if (!el.contains(event.target)) el.removeAttribute('open');
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      document.querySelectorAll('.site-header__dropdown[open]').forEach((el) => el.removeAttribute('open'));
    }
  });

  // Cart count badge, kept in sync by the cart controller (sections/cart-drawer.liquid).
  document.addEventListener('cart:updated', (event) => {
    const countEls = document.querySelectorAll('[data-cart-count]');
    const count = event.detail?.item_count ?? event.detail?.itemCount;
    if (typeof count !== 'number') return;
    countEls.forEach((el) => {
      el.textContent = count;
      el.hidden = count === 0;
    });
  });

  // Lightweight predictive search: enhances the plain GET search form using
  // Shopify's native Predictive Search API + Section Rendering API. The
  // "predictive-search" section (sections/predictive-search.liquid) does the
  // actual rendering server-side; this just fetches and injects its markup.
  // Degrades gracefully to a normal form submission if this fails or JS is
  // unavailable.
  const resultsEl = document.querySelector('[data-predictive-search-results]');
  const searchInput = document.querySelector('[data-search-input]');
  let searchController;
  let searchDebounce;

  searchInput?.addEventListener('input', (event) => {
    const query = event.target.value.trim();
    clearTimeout(searchDebounce);

    if (searchController) searchController.abort();

    if (query.length < 2 || !window.themeRoutes?.predictiveSearchUrl) {
      resultsEl.hidden = true;
      resultsEl.innerHTML = '';
      searchInput.setAttribute('aria-expanded', 'false');
      return;
    }

    searchDebounce = setTimeout(() => {
      searchController = new AbortController();
      const url = `${window.themeRoutes.predictiveSearchUrl}?q=${encodeURIComponent(
        query
      )}&section_id=predictive-search&resources[type]=product,page,article&resources[limit]=6`;

      fetch(url, { signal: searchController.signal })
        .then((response) => response.text())
        .then((html) => {
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const content = doc.querySelector('#shopify-section-predictive-search');
          resultsEl.innerHTML = content ? content.innerHTML : '';
          resultsEl.hidden = !content;
          searchInput.setAttribute('aria-expanded', String(!!content));
        })
        .catch(() => {});
    }, 200);
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}

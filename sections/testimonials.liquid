{% comment %}
  A reusable grid of customer testimonials, each added as a "testimonial"
  block so merchants can add, remove and reorder them freely.
{% endcomment %}

<div class="testimonials full-width section-padding">
  <div class="testimonials__inner">
    {% if section.settings.heading != blank %}
      <div class="section-header section-header--center">
        <h2 class="section-header__heading h3">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="testimonials__grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .testimonials {
    background: var(--color-background);
  }

  .testimonials__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Kata mereka yang sudah belajar bersama kami"
    }
  ],
  "blocks": [{ "type": "testimonial" }],
  "presets": [
    {
      "name": "t:general.testimonials",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}

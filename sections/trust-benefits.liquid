{% comment %}
  A row of 3-4 trust/benefit items (icon, title, description), each defined
  as a "benefit" block so merchants can add, remove and reorder them.
{% endcomment %}

<div class="trust-benefits full-width section-padding">
  <div class="trust-benefits__inner">
    {% if section.settings.heading != blank %}
      <div class="section-header section-header--center">
        <h2 class="section-header__heading h3">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="trust-benefits__grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .trust-benefits__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .trust-benefits__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.trust_benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Kenapa belajar bersama Desa Coding"
    }
  ],
  "blocks": [{ "type": "benefit" }],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:general.trust_benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "shield-check",
            "title": "Produk berkualitas",
            "description": "Dipilih dan diuji agar sesuai kebutuhan belajar dan berkarya Anda."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "check",
            "title": "Pembayaran aman",
            "description": "Transaksi terenkripsi melalui Shopify Checkout yang terpercaya."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "life-buoy",
            "title": "Dukungan terpercaya",
            "description": "Tim kami siap membantu sebelum dan sesudah Anda membeli."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "sparkles",
            "title": "Akses & proses mudah",
            "description": "Belanja, checkout, hingga akses materi dalam beberapa langkah saja."
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% comment %}
  A frequently-asked-questions accordion built entirely from "faq-item"
  blocks, using native <details>/<summary> for full keyboard support
  without any external accordion library.
{% endcomment %}

<div class="faq full-width section-padding">
  <div class="faq__inner">
    {% if section.settings.heading != blank %}
      <div class="section-header section-header--center">
        <h2 class="section-header__heading h3">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="faq__list">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .faq__inner {
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Pertanyaan yang sering diajukan"
    }
  ],
  "blocks": [{ "type": "faq-item" }],
  "presets": [
    {
      "name": "t:general.faq",
      "blocks": [{ "type": "faq-item" }, { "type": "faq-item" }, { "type": "faq-item" }]
    }
  ]
}
{% endschema %}

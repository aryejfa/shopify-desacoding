{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="password-page">
  <div class="password-page__inner card card--padded">
    {% if settings.logo %}
      {{ settings.logo | image_url: width: 160 | image_tag: alt: shop.name, class: 'password-page__logo' }}
    {% else %}
      <p class="h4">{{ shop.name }}</p>
    {% endif %}

    <h1 class="h3">{{ 'password.title' | t }}</h1>

    {% if shop.password_message %}
      <p class="text-secondary">{{ shop.password_message }}</p>
    {% endif %}

    {% form 'storefront_password' %}
      {% if form.errors %}
        <div class="field__message" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}

      <div class="field">
        <label for="password-input" class="field__label">{{ 'password.password' | t }}</label>
        <input type="password" name="password" id="password-input" class="field__input" required>
      </div>

      <button type="submit" class="btn btn--block">{{ 'password.enter' | t }}</button>
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .password-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--page-margin);
    background: var(--color-background);
  }

  .password-page__inner {
    width: 100%;
    max-width: 26rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  .password-page__logo {
    margin-inline: auto;
    max-height: 2.5rem;
    width: auto;
  }

  .password-page .field {
    text-align: left;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}

{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="page section-padding full-width">
  <div class="page__inner">
    <h1 class="page__title h2">{{ page.title }}</h1>
    <div class="rte">{{ page.content }}</div>
  </div>
</div>

{% stylesheet %}
  .page__inner {
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .page__title {
    margin-block-end: 1.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}

{% comment %}
  Search results page: products use the shared product card; pages and
  articles render as simple resource cards. Includes empty and
  not-yet-searched states.
{% endcomment %}

<div class="search-page section-padding full-width">
  <div class="search-page__inner">
    <div class="section-header section-header--center">
      <h1 class="section-header__heading h2">{{ 'search.title' | t }}</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
        <input type="hidden" name="type" value="product,page,article">
        {% render 'icon', name: 'search' %}
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          aria-label="{{ 'search.placeholder' | t }}"
        >
        <button type="submit" class="btn btn--sm">{{ 'search.submit' | t }}</button>
      </form>
    </div>

    {% if search.performed %}
      {% if search.results_count == 0 %}
        <div class="empty-state">
          {% render 'icon', name: 'search', class: 'icon--lg' %}
          <h2 class="h5">{{ 'search.no_results_html' | t: terms: search.terms }}</h2>
          <p>{{ 'search.no_results_suggestion' | t }}</p>
        </div>
      {% else %}
        <p class="text-secondary text-center">
          {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
        </p>

        {% paginate search.results by 24 %}
          <div class="search-page__grid">
            {% for result in search.results %}
              {% if result.object_type == 'product' %}
                {% render 'product-card', product: result %}
              {% else %}
                <a href="{{ result.url }}" class="search-result-card card">
                  {% assign result_image = result.featured_image | default: result.image %}
                  {% if result_image %}
                    {% render 'image', image: result_image, width: 400, height: 300, crop: 'center', class: 'search-result-card__image' %}
                  {% endif %}
                  <div class="search-result-card__content">
                    <span class="badge">{{ result.object_type | capitalize }}</span>
                    <p class="search-result-card__title">{{ result.title }}</p>
                  </div>
                </a>
              {% endif %}
            {% endfor %}
          </div>

          {% render 'pagination', paginate: paginate %}
        {% endpaginate %}
      {% endif %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .search-page__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .search-page__form {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 32rem;
    margin: 1.25rem auto 2rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-full);
  }

  .search-page__form input[type='search'] {
    flex: 1;
    border: none;
    outline: none;
    font: inherit;
    background: transparent;
  }

  .search-page__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem 1rem;
  }

  @media screen and (min-width: 750px) {
    .search-page__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem 1.5rem;
    }
  }

  .search-result-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }

  .search-result-card__image {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }

  .search-result-card__content {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .search-result-card__title {
    margin: 0;
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}

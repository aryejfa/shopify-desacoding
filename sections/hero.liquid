{% comment %}
  Homepage hero: heading, description, two CTAs and a responsive image
  (desktop/mobile variants, position and overlay), fully editable in the
  Theme Editor.
{% endcomment %}

<div
  class="hero full-width {{ section.settings.content_position }}"
  style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"
>
  {% if section.settings.image != blank or section.settings.image_mobile != blank %}
    <div class="hero__media">
      {% if section.settings.image %}
        <picture>
          {% if section.settings.image_mobile %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ section.settings.image_mobile | image_url: width: 750 }} 750w,
                {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w
              "
            >
          {% endif %}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              widths: '750, 1100, 1500, 2000, 2400',
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.image.alt | default: section.settings.heading,
              class: 'hero__image'
          }}
        </picture>
      {% elsif section.settings.image_mobile %}
        {{
          section.settings.image_mobile
          | image_url: width: 1500
          | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.heading, class: 'hero__image'
        }}
      {% endif %}
      <div class="hero__overlay"></div>
    </div>
  {% endif %}

  <div class="hero__content" {% if section.settings.image == blank %}data-animate{% endif %}>
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="hero__description">{{ section.settings.description }}</p>
    {% endif %}

    {% if section.settings.cta_label != blank or section.settings.secondary_cta_label != blank %}
      <div class="hero__actions">
        {% render 'button', label: section.settings.cta_label, url: section.settings.cta_link, size: 'lg' %}
        {% render 'button', label: section.settings.secondary_cta_label, url: section.settings.secondary_cta_link, style: 'outline', size: 'lg' %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    overflow: hidden;
    color: var(--color-foreground);
  }

  .hero:has(.hero__media) {
    color: #fff;
    min-height: clamp(24rem, 60vh, 42rem);
  }

  .hero__media {
    grid-area: 1 / 1;
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--color-primary);
    opacity: var(--overlay-opacity, 0.35);
  }

  .hero__content {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
    max-width: var(--page-width);
    width: 100%;
    margin-inline: auto;
    padding: clamp(3rem, 2rem + 4vw, 6rem) var(--page-margin);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 40rem;
  }

  .hero:not(:has(.hero__media)) {
    background: var(--color-background);
  }

  .hero:not(:has(.hero__media)) .hero__content {
    max-width: var(--page-width);
  }

  .hero--content-center .hero__content {
    margin-inline: auto;
    align-items: center;
    text-align: center;
  }

  .hero--content-right .hero__content {
    margin-inline-start: auto;
    align-items: flex-end;
    text-align: right;
  }

  .hero__heading {
    margin: 0;
  }

  .hero__description {
    max-width: 44ch;
    font-size: 1.0625rem;
    opacity: 0.92;
  }

  .hero--content-center .hero__description {
    max-width: 60ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }

  .hero:has(.hero__media) .btn--outline {
    border-color: #fff;
    color: #fff;
  }

  .hero:has(.hero__media) .btn--outline:hover {
    background: #fff;
    color: var(--color-primary);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.subheading",
      "default": "Desa Coding"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Belajar, Berkarya, dan Tumbuh Bersama Teknologi"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Temukan produk, kelas, dan solusi digital yang membantu meningkatkan kemampuan serta produktivitas Anda."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label",
      "default": "Lihat Produk"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.cta_link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "t:labels.secondary_cta_label",
      "default": "Pelajari Lebih Lanjut"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "t:labels.secondary_cta_link"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:labels.image_mobile"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:labels.overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:labels.content_position",
      "options": [
        { "value": "hero--content-left", "label": "t:options.content_position.left" },
        { "value": "hero--content-center", "label": "t:options.content_position.center" },
        { "value": "hero--content-right", "label": "t:options.content_position.right" }
      ],
      "default": "hero--content-left"
    }
  ],
  "presets": [{ "name": "t:general.hero" }]
}
{% endschema %}
